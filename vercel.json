{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/app" },

    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },

    { "source": "/courses", "destination": "/levelcourses.html" },
    { "source": "/courses/(.*)", "destination": "/coursemodul.html" },

    { "source": "/lesson", "destination": "/lesson.html" },
    { "source": "/lesson/(.*)", "destination": "/lesson.html" },

    { "source": "/finallytask", "destination": "/finallytask.html" },
    { "source": "/admin", "destination": "/admin.html" },

    { "source": "/(.*)", "destination": "/$1" }
  ]
}
